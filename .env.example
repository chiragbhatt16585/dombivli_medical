DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=dombivali_medical
DB_USER=travelworld
DB_PASS=travelworld

APP_DEBUG=1
APP_URL=http://127.0.0.1:8080

# Route Mobile OTP API (https://api.rmlconnect.net/OtpApi/otpgenerate)
# Leave RM_USERNAME empty while testing. With APP_DEBUG=1 the OTP message
# is stored for Admin → SMS Manager instead of being sent.
RM_BASE_URL=https://api.rmlconnect.net
RM_USERNAME=
RM_PASSWORD=
RM_SENDER=
RM_OTP_LENGTH=6
RM_OTP_EXPIRY=300
RM_MESSAGE=Your Dombivali Medical Association login OTP is %m. It is valid for 5 minutes. Do not share this OTP.
